{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "GEMINI_API_KEY": "",
  "Gemini": {
    "GenerationModel": "gemini-3.8-flash"
    //"GenerationModel": "gemini-1.5-flash"
    //"GenerationModel": "gemini-2.5-flash-lite"
    //"GenerationModel": "gemini-2.5-flash"
    //"GenerationModel": "gemini-2.0-flash"
    //"GenerationModel": "gemini-3.5-flash-lite",
    //"GenerationModel": "gemini-3.1-flash-lite"
  },
  "Groq": {
    "Model": "openai/gpt-oss-120b"
  },
  "ComplianceSettings": {
    "AaoifiDebtRatioLimit": 0.33,
    "AaoifiCashRatioLimit": 0.33,
    "AaoifiReceivablesRatioLimit": 0.33,
    "AaoifiRevenueHaramLimit": 0.05
  },
  "VectorStore": {
    "JsonStoragePath": "data/knowledge_base_vectors.json",
    "MinimumSimilarity": 0.55
  }
}
